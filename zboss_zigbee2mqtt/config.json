{
  "name": "Zigbee2MQTT ZBOSS (ESP32-C6)",
  "version": "2.13.0",
  "slug": "zboss_zigbee2mqtt",
  "description": "Zigbee2MQTT com suporte nativo ZBOSS para ESP32-C6 e ESP32-H2 (baseado no patch tostmann/esp-coordinator)",
  "icon": true,
  "logo": true,
  "panel_icon": "mdi:zigbee",
  "uart": true,
  "udev": true,
  "url": "https://github.com/wesioplayconstructor/zboss-zigbee2mqtt-app",
  "startup": "application",
  "services": [
    "mqtt:need"
  ],
  "hassio_api": true,
  "arch": [
    "aarch64",
    "amd64"
  ],
  "boot": "auto",
  "init": false,
  "ingress": true,
  "timeout": 30,
  "map": [
    {
      "type": "share",
      "read_only": false
    },
    {
      "type": "homeassistant_config",
      "read_only": false,
      "path": "/config"
    },
    {
      "type": "addon_config",
      "read_only": false,
      "path": "/addon_config"
    }
  ],
  "ports": {
    "8485/tcp": 8485,
    "8099/tcp": null
  },
  "ports_description": {
    "8485/tcp": "Socat tcp-listen port",
    "8099/tcp": "Frontend tcp-listen port"
  },
  "options": {
    "data_path": "/config/zigbee2mqtt_zboss",
    "socat": {
      "enabled": false,
      "master": "pty,raw,echo=0,link=/tmp/ttyZ2M,mode=777",
      "slave": "tcp-listen:8485,keepalive,nodelay,reuseaddr,keepidle=1,keepintvl=1,keepcnt=5",
      "options": "-d -d",
      "log": false
    },
    "mqtt": {
      "base_topic": "zigbee2mqtt_zboss"
    },
    "serial": {
      "adapter": "zboss",
      "baudrate": 115200
    }
  },
  "schema": {
    "data_path": "str",
    "socat": {
      "enabled": "bool?",
      "master": "str?",
      "slave": "str?",
      "options": "str?",
      "log": "bool?",
      "log_level": "str?"
    },
    "mqtt": {
      "server": "str?",
      "ca": "str?",
      "key": "str?",
      "cert": "str?",
      "user": "str?",
      "password": "str?",
      "base_topic": "str?"
    },
    "serial": {
      "port": "device(subsystem=tty)?",
      "adapter": "match(zboss|zstack|deconz|zigate|ezsp|ember)?",
      "baudrate": "int?",
      "rtscts": "bool?"
    },
    "watchdog": "str?",
    "force_onboarding": "bool?"
  }
}
